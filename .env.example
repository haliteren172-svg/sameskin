# ---- YouCam API (required for live scans) ----
# Get a key at https://yce.perfectcorp.com/api-console/en/api-keys/
YOUCAM_API_KEY=
# HD gives 28 sub-scores (22 units/scan). SD gives 16 scores (16 units/scan).
YOUCAM_TIER=HD

# ---- Optional: Claude agent for "For skin like yours" summaries ----
# Without it SameSkin falls back to a deterministic summariser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Demo mode: run the full product without spending API units ----
# true  -> scans return a recorded YouCam response (no key needed)
# false -> scans call the live YouCam API
DEMO_MODE=true

PORT=8787
